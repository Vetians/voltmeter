<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Glowing Voltage Circle Ring -->
    <path
        android:pathData="M 54,21 A 33,33 0 1,1 53.99,21 Z"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="21"
                android:startY="21"
                android:endX="87"
                android:endY="87"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#FFD600" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Electric Bolt (Zoomed In & Bold) -->
    <path
        android:pathData="M 60,16 L 30,54 L 52,54 L 44,92 L 78,50 L 54,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="16"
                android:endX="78"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFEE55" />
                <item android:offset="0.5" android:color="#FFD600" />
                <item android:offset="1.0" android:color="#FF9100" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Highlight for Depth -->
    <path
        android:pathData="M 58,22 L 36,52 L 53,52 L 48,80 L 70,52 L 55,52 Z"
        android:fillColor="#80FFFFFF" />
</vector>
